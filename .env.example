# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gold Price API Key (goldapi.io) — currently unused; the app uses the
# free, keyless gold-api.com endpoint as a fallback instead.
GOLD_API_KEY=""

# Currency API Key (currencyapi.com) — currently unused; the app uses the
# free, keyless open.er-api.com endpoint as a fallback instead.
CURRENCY_API_KEY=""

# Resend API key: required to send the "new request" notification email
# when someone submits the request form. Get a free key at https://resend.com
RESEND_API_KEY=""

# Where the "new request" notification email is sent. Defaults to
# mostafamadadi.1382@gmail.com if not set.
CONTACT_TO_EMAIL="mostafamadadi.1382@gmail.com"

# The "from" address for outgoing notification emails. On Resend's free tier,
# without a verified domain you must use onboarding@resend.dev.
CONTACT_FROM_EMAIL="Khazaneh <onboarding@resend.dev>"
